// Cloudflare Worker config for Talo. Free tier only.
// Secrets and per-deployment values (ACCESS_TEAM_DOMAIN, ACCESS_AUD, ADMIN_EMAILS)
// are set in the Cloudflare dashboard, or in .dev.vars locally (git-ignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rightroom",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The collector checks a few due sources every hour (free tier includes Cron Triggers).
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talo",
      // Dan's D1 database (created 2026-11-14). The ID isn't secret.
      "database_id": "78b5bc83-abb4-44e4-9180-28b08fce12e8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
